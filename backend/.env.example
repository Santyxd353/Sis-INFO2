# development | production. Producción exige una clave aleatoria de 50+ caracteres y hosts explícitos.
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Carpeta privada para copias y ruta al ejecutable pg_dump compatible con el servidor.
# RESPALDOS_ROOT=D:\\Unidad\\respaldos
# PG_DUMP_PATH=C:\\Program Files\\PostgreSQL\\18\\bin\\pg_dump.exe
# En producción redirige HTTP a HTTPS por defecto. Si TLS termina en un proxy,
# configurar la redirección en el proxy y desactivar esta opción solo cuando
# el backend sea accesible exclusivamente desde ese proxy de confianza.
# DJANGO_SECURE_SSL_REDIRECT=false
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ejemplo.com
# Activar HSTS solo después de comprobar HTTPS en todos los dominios afectados.
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# IPs de proxies reversos autorizados a informar X-Forwarded-For, separadas por coma.
TRUSTED_PROXY_IPS=

# PostgreSQL local
DB_NAME=colegio
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Duracion de los tokens JWT. Estos valores no son secretos.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Gemini para interpretar solicitudes de reportes (configurar en backend/.env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Pasarela QR Vendis: usar credenciales del ambiente correspondiente.
# VENDIS_ENV=simulado (solo con DEBUG) genera QR de prueba para pensiones sin credenciales.
# Para un colegio de demostración con DEBUG desactivado, indica sus IDs separados por comas.
FINANZAS_QR_DEMO_COLEGIO_IDS=
VENDIS_ENV=sandbox
VENDIS_API_BASE_URL=https://qr-dev.cobranza.emizor.com
VENDIS_API_KEY=
VENDIS_BUSINESS_CODE=
VENDIS_WEBHOOK_TOKEN=

# En desarrollo, los enlaces de verificación se imprimen en la consola Django.
FRONTEND_PUBLIC_URL=http://127.0.0.1:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=no-reply@localhost
PG_DUMP_PATH=C:/Program Files/PostgreSQL/17/bin/pg_dump.exe
